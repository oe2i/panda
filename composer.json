{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "oe2i/panda",
    "type": "project",
    "description": "Opinionated Laravel 13 + Livewire 4 + Flux UI starter kit.",
    "keywords": [
        "oe2i",
        "panda",
        "laravel",
        "livewire",
        "starter-kit"
    ],
    "homepage": "https://github.com/oe2i/panda",
    "readme": "README.md",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Osawere",
            "email": "anthony@osawere.com",
            "homepage": "https://www.osawere.com",
            "role": "Software Engineer"
        },
        {
            "name": "oe2i",
            "email": "hi@oe2i.com",
            "homepage": "https://oe2i.com",
            "role": "Organization"
        }
    ],
    "support": {
        "email": "hi@oe2i.com",
        "issues": "https://github.com/oe2i/panda/issues",
        "source": "https://github.com/oe2i/panda"
    },
    "require": {
        "php": "^8.5",
        "laravel/ai": "*",
        "laravel/chisel": "^0.1.0",
        "laravel/folio": "^1.3",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/prompts": "^0.3.27",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/vet": "^0.2.1",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.13.1",
        "livewire/livewire": "^4.1",
        "nunomaduro/essentials": "^1.2.0",
        "spatie/browsershot": "^5.5",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.5",
        "spatie/laravel-csp": "^3.31",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-pdf": "^2.14",
        "spatie/laravel-permission": "^8.5",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-sluggable": "^6.0",
        "spatie/laravel-translatable": "^6.15",
        "spatie/simple-excel": "^3.11"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.24",
        "fruitcake/laravel-debugbar": "^4.4",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "peckphp/peck": "^0.3.0",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-agent": "*",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-browser": "^5.2",
        "pestphp/pest-plugin-evals": "*",
        "pestphp/pest-plugin-faker": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-phpstan": "*",
        "pestphp/pest-plugin-profanity": "^5.0",
        "pestphp/pest-plugin-rector": "*",
        "pestphp/pest-plugin-stressless": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.1",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "lint:check": [
            "pint --test",
            "rector --dry-run"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "vet:trust": [
            "composer install --no-plugins",
            "vet --fresh"
        ],
        "release": "@php scripts/release.php",
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
